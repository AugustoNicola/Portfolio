---
import { socials } from '../data/profile'
import Icon from './Icon.astro'

interface Props {
  linkClass?: string
  iconClass: string
}

const { linkClass, iconClass } = Astro.props
---

{
  socials.map((social) => (
    <a target="_blank" rel="noreferrer" href={social.href} class={linkClass} aria-label={social.name} title={social.name}>
      {social.img ? (
        <img src={social.img} alt={social.name} class={iconClass} />
      ) : (
        <span class={`${iconClass} ${iconClass}--svg`}>
          <Icon name={social.icon!} />
        </span>
      )}
    </a>
  ))
}
