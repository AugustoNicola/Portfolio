---
import { languages, localizePath, useTranslations, type Lang } from '../i18n'

interface Props {
  lang: Lang
  /** Current path without the language prefix, used by the language switch. */
  neutralPath: string
}

const { lang, neutralPath } = Astro.props
const t = useTranslations(lang)
const home = localizePath('/', lang)
const links = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#research`, label: t('nav.research') },
  { href: `${home}#projects`, label: t('nav.projects') },
  { href: `${home}#cv`, label: t('nav.cv') },
]
const otherLang = languages.find((l) => l !== lang)!
---

<header class="header">
  <div class="header__content">
    <a href={home} class="header__logo-container">
      <div class="header__logo-img-cont">
        <img src="/assets/png/me.png" alt="Augusto Nicola" class="header__logo-img" />
      </div>
      <span class="header__logo-sub">Augusto Nicola</span>
    </a>
    <div class="header__main">
      <ul class="header__links">
        {
          links.map((link) => (
            <li class="header__link-wrapper">
              <a href={link.href} class="header__link">{link.label}</a>
            </li>
          ))
        }
      </ul>
      <a
        href={localizePath(neutralPath, otherLang)}
        hreflang={otherLang}
        class="lang-toggle"
        aria-label={t('nav.switchLang')}
        title={t('nav.switchLang')}
        data-lang-toggle
      >
        {
          languages.map((l) => (
            <span class:list={['lang-toggle__option', { 'lang-toggle__option--active': l === lang }]}>
              {l.toUpperCase()}
            </span>
          ))
        }
      </a>
      <button
        type="button"
        class="theme-toggle"
        aria-label={t('nav.themeDark')}
        title={t('nav.themeDark')}
        data-theme-toggle
        data-label-dark={t('nav.themeDark')}
        data-label-light={t('nav.themeLight')}
      >
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <button class="header__main-ham-menu-cont" aria-label={t('nav.menuOpen')} aria-expanded="false" data-label-open={t('nav.menuOpen')} data-label-close={t('nav.menuClose')}>
        <img src="/assets/svg/ham-menu.svg" alt="" class="header__main-ham-menu" />
        <img src="/assets/svg/ham-menu-close.svg" alt="" class="header__main-ham-menu-close d-none" />
      </button>
    </div>
  </div>
  <div class="header__sm-menu">
    <div class="header__sm-menu-content">
      <ul class="header__sm-menu-links">
        {
          links.map((link) => (
            <li class="header__sm-menu-link">
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<script>
  const hamMenuBtn = document.querySelector<HTMLButtonElement>('.header__main-ham-menu-cont')!
  const smallMenu = document.querySelector('.header__sm-menu')!
  const headerHamMenuBtn = document.querySelector('.header__main-ham-menu')!
  const headerHamMenuCloseBtn = document.querySelector('.header__main-ham-menu-close')!

  function setMenuOpen(open: boolean) {
    smallMenu.classList.toggle('header__sm-menu--active', open)
    headerHamMenuBtn.classList.toggle('d-none', open)
    headerHamMenuCloseBtn.classList.toggle('d-none', !open)
    hamMenuBtn.setAttribute('aria-expanded', String(open))
    hamMenuBtn.setAttribute('aria-label', (open ? hamMenuBtn.dataset.labelClose : hamMenuBtn.dataset.labelOpen) ?? '')
  }

  hamMenuBtn.addEventListener('click', () => {
    setMenuOpen(!smallMenu.classList.contains('header__sm-menu--active'))
  })

  document.querySelectorAll('.header__sm-menu-link').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false))
  })

  // Theme: the inline script in Base.astro already applied the initial theme.
  // A choice that matches the system setting isn't saved, so the site keeps following the system.
  const root = document.documentElement
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!
  const systemDark = matchMedia('(prefers-color-scheme: dark)')
  const systemTheme = () => (systemDark.matches ? 'dark' : 'light')

  function savedTheme() {
    try {
      return localStorage.getItem('theme')
    } catch {
      return null
    }
  }

  function applyTheme(theme: string) {
    root.dataset.theme = theme
    const label = (theme === 'dark' ? themeToggle.dataset.labelLight : themeToggle.dataset.labelDark) ?? ''
    themeToggle.setAttribute('aria-label', label)
    themeToggle.title = label
  }

  themeToggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
    try {
      if (next === systemTheme()) localStorage.removeItem('theme')
      else localStorage.setItem('theme', next)
    } catch {
      // Storage unavailable (e.g. private mode): the choice just lasts for this page
    }
    applyTheme(next)
  })

  systemDark.addEventListener('change', () => {
    if (!savedTheme()) applyTheme(systemTheme())
  })

  applyTheme(root.dataset.theme ?? systemTheme())

  // Keep the visitor on the same section when switching languages.
  document.querySelector<HTMLAnchorElement>('[data-lang-toggle]')!.addEventListener('click', (e) => {
    if (!location.hash) return
    e.preventDefault()
    location.href = (e.currentTarget as HTMLAnchorElement).href + location.hash
  })
</script>
