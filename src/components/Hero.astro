---
import { useTranslations, type Lang } from '../i18n'
import { heroText } from '../data/profile'
import SocialLinks from './SocialLinks.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<section id="home" class="home-hero">
  <div class="home-hero__content">
    <h1 class="heading-primary" data-fadein style="animation-delay: 0.4s;">{t('hero.title')}</h1>
    <p class="home-hero__tagline" data-fadein style="animation-delay: 0.5s;">{t('hero.tagline')}</p>
    <div class="home-hero__info">
      <p class="text-primary" data-fadein style="animation-delay: 0.6s;" set:html={heroText[lang]} />
    </div>
    <div class="home-hero__cta" data-fadein style="animation-delay: 0.8s;">
      <a href="#research" class="btn btn--bg">{t('hero.cta')}</a>
      <a href="#cv" class="btn btn--ghost">{t('hero.ctaSecondary')}</a>
    </div>
  </div>
  <div class="home-hero__socials" data-fadein style="animation-delay: 1s;">
    <SocialLinks linkClass="home-hero__social-icon-link" iconClass="home-hero__social-icon" />
  </div>
  <div class="home-hero__mouse-scroll-cont" data-fadein style="animation-delay: 0.8s;">
    <div class="mouse"></div>
  </div>
</section>
