---
import Base from '../layouts/Base.astro'
import { ui } from '../i18n'
---

<Base lang="en" title="Error 404 | Augusto Nicola">
  <section id="error" class="home-hero">
    <div class="home-hero__content">
      <h1 class="heading-primary" data-fadein style="animation-delay: 0.4s;">Error 404</h1>
      <div class="home-hero__info">
        <p class="text-primary" data-fadein style="animation-delay: 0.6s;">{ui.en['404.text']}</p>
        <p class="text-primary home-hero__info-alt" lang="es" data-fadein style="animation-delay: 0.7s;">{ui.es['404.text']}</p>
      </div>
      <div class="home-hero__cta" data-fadein style="animation-delay: 0.8s;">
        <a href="/" class="btn btn--bg">{ui.en['404.cta']}</a>
        <a href="/es/" class="btn btn--ghost" lang="es">{ui.es['404.cta']}</a>
      </div>
    </div>
  </section>
</Base>
